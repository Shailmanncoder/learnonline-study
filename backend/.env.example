# Generate a unique secret: openssl rand -hex 32
JWT_SECRET=
PORT=5001
# Select deliberately: mysql (default) or sqlite. Failures never switch databases.
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=studyhub
DB_PASSWORD=
DB_NAME=studyhub
# NCERT textbook search (Postgres + pgvector).
# With docker compose, the ncert-db service reads POSTGRES_* from this file
# and the app reaches it by service name:
# POSTGRES_USER=studyhub
# POSTGRES_PASSWORD=   (generate: openssl rand -hex 24)
# POSTGRES_DB=studyhub
# NCERT_PG_URL=postgres://studyhub:PASSWORD@ncert-db:5432/studyhub
# For a database on the Docker host instead, use host.docker.internal:
# NCERT_PG_URL=postgres://USER:PASSWORD@host.docker.internal:5440/studyhub
# Which provider answers first. Leave blank (or use "groq") for Groq first with
# Gemini as the fallback; set to "gemini" for Gemini first with Groq as the
# fallback. Whichever is second catches the other's failures, so keeping both
# keys set means one provider being down does not take the AI features offline.
AI_PROVIDER=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional providers
GEMINI_API_KEY=
# Only catalogue models are accepted (see services/geminiModels.js);
# anything else falls back to the default.
GEMINI_MODEL=gemini-3.6-flash
OPENAI_API_KEY=
SARVAM_API_KEY=

# Enable YouTube Data API v3 for this server-side key to use Companion video ranking.
YOUTUBE_API_KEY=

# ── Payments (Razorpay) ───────────────────────────────────────────
# The server reads this file's real counterpart, backend/.env, because
# server.js calls dotenv.config() with no path and is started from backend/.
# Never commit real keys. The browser only ever sees RAZORPAY_KEY_ID.

# Which environment processes payments.
#   test  -> local simulator UNLESS a real rzp_test_ key is set below,
#            in which case Razorpay Test Mode is used.
#   live  -> Razorpay Live. Requires every PAYMENTS_* gate further down.
PAYMENTS_MODE=test

# Razorpay dashboard -> Account & Settings -> API Keys.
# Test keys start rzp_test_, live keys start rzp_live_.
RAZORPAY_KEY_ID=your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Razorpay dashboard -> Account & Settings -> Webhooks.
# The secret you type when creating the webhook. Endpoint to register:
#   https://<your-domain>/api/payments/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Only for the LOCAL simulator's own fake webhooks. Unrelated to Razorpay.
PAYMENTS_TEST_WEBHOOK_SECRET=

# Comma-separated user ids allowed into /admin/payments (refunds, reviews).
# Empty means nobody can reach payment administration.
PAYMENTS_ADMIN_IDS=

# ── Live-mode gates. Checkout stays disabled until ALL are satisfied ──
PAYMENTS_LIVE_ENABLED=false
PAYMENTS_TERMS_APPROVED=false
PAYMENTS_PUBLIC_URL=
PAYMENTS_SELLER_NAME=
PAYMENTS_SELLER_ADDRESS=
PAYMENTS_SUPPORT_EMAIL=
# Tax in basis points (0 = none). Any non-zero value also requires PAYMENTS_GSTIN.
PAYMENTS_TAX_BPS=0
PAYMENTS_GSTIN=

# Optional: emailed receipts (downloadable PDFs work without these).
PAYMENTS_SMTP_HOST=
PAYMENTS_SMTP_PORT=
PAYMENTS_SMTP_USER=
PAYMENTS_SMTP_PASSWORD=
PAYMENTS_EMAIL_FROM=support@shailmanntech.com

# ── Email (password reset, email confirmation, receipts) ───────────
# Resend's HTTP API is used when RESEND_API_KEY is set — one secret, no ports
# to be blocked, and failures come back with a readable reason. The sending
# domain must be verified in Resend or it refuses the message.
RESEND_API_KEY=

# Any SMTP provider works, including the free tiers: Brevo, Resend, Mailjet,
# or a Gmail account with an app password. The payments receipts already read
# PAYMENTS_SMTP_* — these are aliases, so one mailbox serves both. Without
# them, password reset still accepts a code but no email is sent.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=support@shailmanntech.com

# ── Continue with Google ───────────────────────────────────────────
# The OAuth 2.0 Client ID from Google Cloud Console (APIs & Services →
# Credentials → OAuth client ID → Web application). Add your site to
# "Authorised JavaScript origins". The client SECRET is not needed: the browser
# returns a signed ID token and the server verifies it against Google's keys.
# Leave blank and the button is hidden rather than shown broken.
GOOGLE_CLIENT_ID=
