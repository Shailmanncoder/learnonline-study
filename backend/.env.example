# Generate a unique secret: openssl rand -hex 32
JWT_SECRET=
PORT=5001
# Select deliberately: mysql (default) or sqlite. Failures never switch databases.
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=studyhub
DB_PASSWORD=
DB_NAME=studyhub
# NCERT textbook search (Postgres + pgvector).
# With docker compose, the ncert-db service reads POSTGRES_* from this file
# and the app reaches it by service name:
# POSTGRES_USER=studyhub
# POSTGRES_PASSWORD=   (generate: openssl rand -hex 24)
# POSTGRES_DB=studyhub
# NCERT_PG_URL=postgres://studyhub:PASSWORD@ncert-db:5432/studyhub
# For a database on the Docker host instead, use host.docker.internal:
# NCERT_PG_URL=postgres://USER:PASSWORD@host.docker.internal:5440/studyhub
# Which provider answers first. Leave blank (or use "groq") for Groq first with
# Gemini as the fallback; set to "gemini" for Gemini first with Groq as the
# fallback. Whichever is second catches the other's failures, so keeping both
# keys set means one provider being down does not take the AI features offline.
AI_PROVIDER=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional providers
GEMINI_API_KEY=
# Only catalogue models are accepted (see services/geminiModels.js);
# anything else falls back to the default.
GEMINI_MODEL=gemini-3.6-flash
OPENAI_API_KEY=
SARVAM_API_KEY=
