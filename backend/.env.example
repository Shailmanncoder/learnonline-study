# Generate a unique secret: openssl rand -hex 32
JWT_SECRET=
PORT=5001
# Select deliberately: mysql (default) or sqlite. Failures never switch databases.
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=studyhub
DB_PASSWORD=
DB_NAME=studyhub
# For Docker with an existing host database, use host.docker.internal.
# NCERT_PG_URL=postgres://USER:PASSWORD@host.docker.internal:5440/studyhub
# Which provider answers first. Leave blank (or use "groq") for Groq first with
# Gemini as the fallback; set to "gemini" for Gemini first with Groq as the
# fallback. Whichever is second catches the other's failures, so keeping both
# keys set means one provider being down or out of quota does not take the AI
# features offline.
AI_PROVIDER=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional providers
GEMINI_API_KEY=
# Only gemini-* names are accepted; anything else falls back to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
SARVAM_API_KEY=
